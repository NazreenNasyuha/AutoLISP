;;; ==========================================================================
;;; SYSTEM      : Civil & Infrastructure CAD Automation Suite
;;; MODULE      : csvupdate.lsp
;;; COMMAND     : CSVUPDATE
;;; DESCRIPTION : Batch Smart Data Injection from Excel/CSV (Drains & Manholes)
;;; AUTHOR      : Professional Infrastructure CAD Automation
;;; COMPATIBILITY: Universal (AutoCAD, AutoCAD LT 2024+, GstarCAD, ZWCAD, BricsCAD)
;;; ==========================================================================
;;;
;;; OVERVIEW & TECHNICAL SPECIFICATIONS:
;;; --------------------------------------------------------------------------
;;; CSVUPDATE bridges civil design calculation spreadsheets directly to CAD
;;; drawings. It parses the 5-column raw engineering parameters generated by the
;;; AutoCAD Smart XLS-to-CSV Bridge (or exported from design spreadsheets):
;;;
;;;   Columns: ID, Size/GL, Length/IL, Gradient/Depth, Category
;;;
;;; Key Capabilities:
;;;   1. Reads and indexes 5-column CSV files into high-speed memory dictionary.
;;;   2. Select-Similar Automation: Drafter selects 1 sample placeholder; the
;;;      system targets all TEXT, MTEXT, and MULTILEADER entities on that layer.
;;;   3. Smart ID Extraction: Parses through hidden MTEXT width codes (e.g. {\W0.5;)
;;;      and formatting delimiters to isolate the true engineering ID.
;;;   4. Dual Routing:
;;;      - SEWERAGE: Rebuilds 4-line Manhole data (GL, IL, Depth) preserving format.
;;;      - DRAINAGE: Formats pipe annotations dynamically applying 4, 2, or 1-line
;;;        rules based on pipe span, while protecting the user's ID prefix.
;;;   5. Visual QA/QC Flagging: Draws thick red bounding boxes around any CAD
;;;      entities missing from the spreadsheet, ensuring 100% drawing compliance.
;;;   6. Summary Alert: Pops up a completion dialogue showing total updated and
;;;      missing items.
;;;
;;; DRAFTING WORKFLOW:
;;; --------------------------------------------------------------------------
;;;   1. Export `AutoCAD_Smart_Raw.csv` from the Web Bridge app.
;;;   2. Type `CSVUPDATE` in the CAD command line.
;;;   3. Select the CSV file in the standard file picker.
;;;   4. Click ONE reference placeholder on the target layer (e.g. text/multileader).
;;;   5. All matching drawing entities are updated instantly with QA/QC flags.
;;; ==========================================================================

(defun c:csvupdate ( / *error* extract-id update-drain update-sewer filename file line pos1 pos2 pos3 pos4 id val1 val2 val3 category dict refSel refEnt refLayer ss count i ent elist entType obj oldTxt cleanId match updated missing pt hgt p1 p2 p3 p4 gap)
  (vl-load-com)
  (setq oldCmd (getvar "CMDECHO"))
  (defun *error* (msg) (if oldCmd (setvar "CMDECHO" oldCmd)) (princ))

  ;; -------------------------------------------------------------------------
  ;; SMART EXTRACTOR
  ;; -------------------------------------------------------------------------
  (defun extract-id (txt / pPos remTxt semiPos slashPos spacePos endPos extId)
    (setq pPos 0)
    (if (= (substr txt 1 2) "{\\")
      (if (setq semiPos (vl-string-search ";" txt)) (setq pPos (1+ semiPos))))
    (setq remTxt (substr txt (1+ pPos)))
    (setq semiPos (vl-string-search ";" remTxt) slashPos (vl-string-search "\\P" remTxt) spacePos (vl-string-search " " remTxt))
    (setq endPos (strlen remTxt))
    (if semiPos (setq endPos (min endPos semiPos)))
    (if slashPos (setq endPos (min endPos slashPos)))
    (if spacePos (setq endPos (min endPos spacePos)))
    (setq extId (substr remTxt 1 endPos))
    (if (wcmatch extId "*\}") (setq extId (substr extId 1 (1- (strlen extId)))))
    (strcase (vl-string-trim " \t" extId))
  )

  ;; -------------------------------------------------------------------------
  ;; DRAINAGE INJECTOR (Preserves ; \P formatting, swaps Size/Len/Grad)
  ;; -------------------------------------------------------------------------
  (defun update-drain (oldTxt size len grad / prefix suffix remTxt semiPos p1 p2 p3 newTxt block1 block2 block3)
    ;; Find the end of the ID
    (setq semiPos (vl-string-search ";" oldTxt))
    (if (not semiPos) (setq semiPos (strlen oldTxt)))
    
    (setq prefix (substr oldTxt 1 (1+ semiPos))) ;; e.g. "{\W0.5;A01;"
    (setq remTxt (substr oldTxt (+ 2 semiPos)))
    
    ;; Build the replacement blocks based on how the Drafter originally spaced them
    (setq block1 (strcat " " size "%%c "))
    (setq block2 (strcat len "m "))
    (setq block3 (strcat "1:" grad))
    
    ;; We use a crude but effective regex-style string replacement for the 3 values
    ;; This assumes the original format has %%c, m, and 1:
    (setq newTxt oldTxt)
    
    ;; Swap Size (looks for numbers before %%c)
    (setq p1 (vl-string-search "%%c" remTxt))
    (if p1 
      (setq newTxt (strcat prefix block1 (substr remTxt (+ 4 p1))))
    )
    
    newTxt ;; Return
  )

  ;; -------------------------------------------------------------------------
  ;; SEWERAGE INJECTOR (Hunts for GL=, IL=, D=)
  ;; -------------------------------------------------------------------------
  (defun update-sewer (oldTxt gl il depth / newTxt)
    (setq newTxt oldTxt)
    ;; Build the Manhole string using the extracted ID: MH\PGL=X\PIL=Y\PD=Z
    (setq cleanId (extract-id oldTxt))
    (setq newTxt (strcat cleanId "\\PGL=" gl "m\\PIL=" il "m\\PD=" depth "m"))
    
    ;; Re-apply any hidden width formatting if it existed
    (if (= (substr oldTxt 1 3) "{\\W")
      (setq newTxt (strcat (substr oldTxt 1 (1+ (vl-string-search ";" oldTxt))) newTxt "}"))
    )
    newTxt
  )

  (princ "\nCommand: CSVUPDATE (Data Injection Engine)")

  ;; 1. Read the 5-Column CSV
  (setq filename (getfiled "Select Engineer's Raw CSV File" "" "csv" 0))
  (if (not filename) (progn (princ "\nNo file selected.") (exit)))

  (setq file (open filename "r") dict nil)
  (while (setq line (read-line file))
    (setq pos1 (vl-string-search "," line)
          pos2 (vl-string-search "," line (1+ pos1))
          pos3 (vl-string-search "," line (1+ pos2))
          pos4 (vl-string-search "," line (1+ pos3)))
    (if pos4
      (progn
        (setq id   (vl-string-trim " \"\t" (substr line 1 pos1))
              val1 (vl-string-trim " \"\t" (substr line (+ 2 pos1) (- pos2 pos1 1)))
              val2 (vl-string-trim " \"\t" (substr line (+ 2 pos2) (- pos3 pos2 1)))
              val3 (vl-string-trim " \"\t" (substr line (+ 2 pos3) (- pos4 pos3 1)))
              category (vl-string-trim " \"\t" (substr line (+ 2 pos4))))
        
        (if (/= id "") (setq dict (cons (cons (strcase id) (list val1 val2 val3 category)) dict)))
      )
    )
  )
  (close file)

  ;; 2. Select Target Layer
  (princ "\nSelect ONE placeholder text to target its layer: ")
  (setq refSel (ssget ":S" '((0 . "TEXT,MTEXT,MULTILEADER")))) 
  (if (not refSel) (progn (princ "\nNo reference text selected.") (exit)))
  
  (setq refEnt (ssname refSel 0) refLayer (cdr (assoc 8 (entget refEnt))))
  (setq ss (ssget "X" (list '(0 . "TEXT,MTEXT,MULTILEADER") (cons 8 refLayer))))
  
  ;; 3. Inject Data
  (if ss
    (progn
      (setq count (sslength ss) i 0 updated 0 missing 0)
      
      (while (< i count)
        (setq ent (ssname ss i) elist (entget ent))
        (setq obj (vlax-ename->vla-object ent) oldTxt (vla-get-TextString obj))
        
        (setq cleanId (extract-id oldTxt) match (assoc cleanId dict))
        
        (if match
          (progn
            (setq dataList (cdr match))
            (setq val1 (nth 0 dataList) val2 (nth 1 dataList) val3 (nth 2 dataList) category (nth 3 dataList))
            
            ;; Route to the correct Injector
            (if (= category "SEWERAGE")
              (setq newTxt (update-sewer oldTxt val1 val2 val3))
              
              ;; DRAINAGE: Rebuilds string applying 4, 2, or 1 paragraph rules based on length, 
              ;; but PROTECTING the user's manual ID prefix
              (progn
                (setq lenNum (atof val2))
                (cond
                  ((<= lenNum 6)  (setq newTxt (strcat cleanId ";\\P" val1 "%%c\\P" val2 "m\\P1:" val3)))
                  ((<= lenNum 14) (setq newTxt (strcat cleanId "; " val1 "%%c\\P" val2 "m 1:" val3)))
                  (T              (setq newTxt (strcat cleanId "; " val1 "%%c " val2 "m 1:" val3)))
                )
                ;; Re-apply hidden width
                (if (= (substr oldTxt 1 3) "{\\W")
                  (setq newTxt (strcat (substr oldTxt 1 (1+ (vl-string-search ";" oldTxt))) newTxt "}"))
                )
              )
            )
            
            (vla-put-TextString obj newTxt)
            (setq updated (1+ updated))
          )
          (progn
            ;; Red Box logic
            (setq pt (cdr (assoc 10 elist)) gap 1500.0) 
            (setq p1 (list (- (car pt) gap) (- (cadr pt) gap) 0.0) p2 (list (+ (car pt) (* gap 3.0)) (- (cadr pt) gap) 0.0) p3 (list (+ (car pt) (* gap 3.0)) (+ (cadr pt) gap) 0.0) p4 (list (- (car pt) gap) (+ (cadr pt) gap) 0.0))
            (entmake (list '(0 . "LWPOLYLINE") '(100 . "AcDbEntity") '(100 . "AcDbPolyline") (cons 8 refLayer) (cons 62 1) '(90 . 4) '(70 . 1) (cons 43 50.0) (list 10 (car p1) (cadr p1)) (list 10 (car p2) (cadr p2)) (list 10 (car p3) (cadr p3)) (list 10 (car p4) (cadr p4))))
            (setq missing (1+ missing))
          )
        )
        (setq i (1+ i))
      )
      (alert (strcat "DATA INJECTION COMPLETE\n\nTarget Layer: " refLayer "\n\nTexts Updated: " (itoa updated) "\n\nMissing from CSV (Red Boxed): " (itoa missing)))
    )
  )
  (princ)
)